{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=cureflow;Username=postgres;Password=REPLACE-WITH-DB-PASSWORD;GSS Encryption Mode=Disable"
  },
  "Jwt": {
    "Secret": "REPLACE-WITH-A-64-CHAR-RANDOM-SECRET-IN-PRODUCTION",
    "Issuer": "cureflow",
    "Audience": "cureflow-api"
  },
  "Anthropic": {
    "ApiKey": "REPLACE-WITH-YOUR-ANTHROPIC-API-KEY"
  },
  "WhatsApp": {
