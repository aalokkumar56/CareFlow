  },
  "Cors": {
    "Origins": "http://localhost:3000,http://localhost:5173,https://care-flow-pearl-theta.vercel.app"
  },
  "Database": {
    "AutoMigrate": true,
    "Seed": false
  },
  "Storage": {
    "LabReportsPath": "lab-reports",
    "PatientDocumentsPath": "patient-documents"
