# CureFlow API — environment variables
# Copy to .env and set values, or use appsettings.Development.json (gitignored).

# PostgreSQL connection string
ConnectionStrings__Default=Host=localhost;Port=5432;Database=cureflow;Username=postgres;Password=REPLACE-WITH-DB-PASSWORD

# JWT signing secret (minimum 32 characters; use 64+ in production)
Jwt__Secret=REPLACE-WITH-A-64-CHAR-RANDOM-SECRET-IN-PRODUCTION
Jwt__Issuer=cureflow
Jwt__Audience=cureflow-api

# Anthropic Claude API key (optional — AI features disabled without it)
Anthropic__ApiKey=REPLACE-WITH-YOUR-ANTHROPIC-API-KEY

# WhatsApp integration (leave empty for demo/offline mode)
WhatsApp__Provider=WhatsBiz
WhatsApp__PhoneNumberId=
WhatsApp__AccessToken=
WhatsApp__AppSecret=
WhatsApp__ApiToken=
WhatsApp__VerifyToken=cureflow-webhook-verify-2026
WhatsApp__Enabled=false
WhatsApp__WhatsBizBaseUrl=https://whatsbizapi.com/api/wpbox/
WhatsApp__RelayWebhookUrl=
WhatsApp__RelayPublicBaseUrl=

# CORS allowed origins (comma-separated)
Cors__Origins=http://localhost:3000,http://localhost:5173

# Lab report file storage (relative to API content root)
Storage__LabReportsPath=lab-reports

# Database startup
Database__AutoMigrate=true
Database__Seed=true
