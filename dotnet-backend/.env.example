# CureFlow API — environment variables
# Copy to .env and set values, or use appsettings.Development.json (gitignored).

# PostgreSQL connection string
# Local:
ConnectionStrings__Default=Host=localhost;Port=5432;Database=cureflow;Username=postgres;Password=REPLACE-WITH-DB-PASSWORD;GSS Encryption Mode=Disable
# Neon/Render example (SSL + longer timeout for cold start):
# ConnectionStrings__Default=Host=ep-xxxx.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=...;SSL Mode=Require;Timeout=60;Command Timeout=60;GSS Encryption Mode=Disable

# JWT signing secret (minimum 32 characters; use 64+ in production)
Jwt__Secret=REPLACE-WITH-A-64-CHAR-RANDOM-SECRET-IN-PRODUCTION
Jwt__Issuer=cureflow
Jwt__Audience=cureflow-api

# Anthropic Claude API key (optional — AI features disabled without it)
Anthropic__ApiKey=REPLACE-WITH-YOUR-ANTHROPIC-API-KEY

# WhatsApp provider credentials (Provider, tokens, phone id, verify token, etc.)
# are configured at runtime per hospital: Settings → Integrations (stored in DB).
# Optional platform-only overrides:
# WhatsApp__RelayWebhookUrl=
# WhatsApp__RelayPublicBaseUrl=
# WhatsApp__MetaGraphApiBaseUrl=https://graph.facebook.com
# WhatsApp__MetaGraphApiVersion=v18.0

# CORS allowed origins (comma-separated). *.vercel.app is also allowed in code.
Cors__Origins=http://localhost:3000,http://localhost:5173,https://care-flow-pearl-theta.vercel.app

# Lab report file storage (relative to API content root)
Storage__LabReportsPath=lab-reports

# Database startup (keep Seed=false on Render/Neon — demo/E2E data is local-only)
Database__AutoMigrate=true
Database__Seed=false
Database__SeedPlatformUsers=false
